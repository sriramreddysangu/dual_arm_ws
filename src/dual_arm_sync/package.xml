<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dual_arm_sync</name>
  <version>1.0.0</version>
  <description>
    Kuramoto-synchronized, collision-free configuration-space trajectory
  generation for ensembles of Doosan M1013 manipulators sharing a workspace.
  Each arm follows an unmodified B-spline path under a repulsive Kuramoto
  phase-oscillator model; only pairs that timing cannot separate are
  deformed with a perpendicular escape injected as B-spline control points.
  Collision decisions use the true convex collision meshes. Includes 2-, 4-
  and 6-arm cells, Gazebo execution and closed-loop benchmarks.
  </description>
  
  <maintainer email="sangu2002.ss@gmail.com">Sriram reddy sangu</maintainer>
  <license>IIT TIRUPATI</license>
  
  <url type="website">https://github.com/sriramreddysangu/dual_arm_sync</url>
  <url type="repository">https://github.com/sriramreddysangu/dual_arm_sync</url>
  <url type="bugtracker">https://github.com/sriramreddysangu/dual_arm_sync/issues</url>
  
  <author email="sangu2002.ss@gmail.com">SRIRAM REDDY SANGU</author>
  
  
  <buildtool_depend>ament_python</buildtool_depend>
  
  
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  
  
  <depend>control_msgs</depend>
  <depend>controller_manager</depend>
  
  
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  
  
  <depend>launch</depend>
  <depend>launch_ros</depend>
  
  <depend>gazebo_ros</depend>
  <depend>ros_gz_sim</depend>
  
  
  <depend>dsr_gazebo2</depend>
  <depend>dsr_description2</depend>
  
  <depend>dsr_control2</depend>
  <depend>dsr_msgs2</depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
